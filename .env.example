# ─────────────────────────────────────────────────────────────────────────────
# SplitShield — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# Network Selection: preview | preprod
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Preprod RPC & Indexer Endpoints
VITE_MIDNIGHT_RPC_URL=https://rpc.preprod.midnight.network
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Proof Server Configuration (Developer Local Mocking / Proving)
# Note: End-users do NOT need Docker; browser wallets run WASM-based provers!
PROOF_SERVER_HOST=localhost
PROOF_SERVER_PORT=6300

# Deployed SplitShield Contract Address on Preprod (Hex string)
VITE_CONTRACT_ADDRESS=

# Midnight Block Explorer
VITE_EXPLORER_URL=https://midnightexplorer.com

# Application Information
VITE_APP_NAME=SplitShield
VITE_APP_URL=http://localhost:5173
