pragma language_version >= 0.23.0;

import CompactStandardLibrary;

// =============================================================================
// PUBLIC LEDGER STATE (On-Chain Settlement)
// =============================================================================
export ledger projectCount: Counter;
export ledger totalProjectsCreated: Counter;
export ledger totalAllocationsVerified: Counter;

export ledger projectOwners: Map<Bytes<32>, Bytes<32>>;        // projectId -> ownerPubKeyHash
export ledger poolCommitments: Map<Bytes<32>, Bytes<32>>;      // projectId -> hash([blinding, projectId])
export ledger ruleCommitments: Map<Bytes<32>, Bytes<32>>;      // projectId -> hash(ruleSet)
export ledger contributorRegistry: Map<Bytes<32>, Boolean>;    // hash([projectId, pubKey]) -> registered
export ledger allocationVerified: Map<Bytes<32>, Boolean>;     // hash([projectId, pubKey]) -> verified
export ledger distributionStatus: Map<Bytes<32>, Uint<64>>;    // projectId -> 0=ACTIVE, 1=DISTRIBUTING, 2=COMPLETED

// =============================================================================
// PRIVATE WITNESSES (Client-side, Never On-Chain)
// =============================================================================
witness getPoolAmount(): Uint<64>;
witness getAllocationAmount(): Uint<64>;
witness getAllocationPercentage(): Uint<64>;
witness getTotalPercentage(): Uint<64>;
witness getBlindingFactor(): Bytes<32>;

// =============================================================================
// CONSTRUCTOR
// =============================================================================
constructor() {
}

// =============================================================================
// INTERNAL HELPERS
// =============================================================================
circuit callerKey(): Bytes<32> {
    return disclose(ownPublicKey().bytes);
}

// =============================================================================
// EXPORTED CIRCUITS (8 Total <= 10 Circuit Budget)
// =============================================================================

// 1. Initialize a new payment project with pool commitment
export circuit createProject(projectId: Bytes<32>): [] {
    const owner = callerKey();
    const blinding = getBlindingFactor();
    const poolCommit = persistentHash<[Bytes<32>, Bytes<32>]>([blinding, projectId]);

    projectOwners.insert(disclose(projectId), owner);
    poolCommitments.insert(disclose(projectId), disclose(poolCommit));
    distributionStatus.insert(disclose(projectId), 0);
    projectCount.increment(1);
    totalProjectsCreated.increment(1);
}

// 2. Define allocation rules for a project
export circuit defineRules(projectId: Bytes<32>, ruleHash: Bytes<32>): [] {
    const caller = callerKey();
    assert(projectOwners.member(disclose(projectId)), "Project not found");
    assert(projectOwners.lookup(disclose(projectId)) == caller, "Only owner can define rules");

    ruleCommitments.insert(disclose(projectId), disclose(ruleHash));
}

// 3. Register a contributor's public key hash
export circuit addContributor(projectId: Bytes<32>, contributorKeyHash: Bytes<32>): [] {
    const caller = callerKey();
    assert(projectOwners.member(disclose(projectId)), "Project not found");
    assert(projectOwners.lookup(disclose(projectId)) == caller, "Only owner can add contributors");

    const regKey = persistentHash<[Bytes<32>, Bytes<32>]>([projectId, contributorKeyHash]);
    contributorRegistry.insert(disclose(regKey), disclose(true));
}

// 4. Allocate funds with ZK proof of rule compliance
export circuit allocateFunds(projectId: Bytes<32>): [] {
    const caller = callerKey();
    assert(projectOwners.member(disclose(projectId)), "Project not found");
    assert(projectOwners.lookup(disclose(projectId)) == caller, "Only owner can allocate");

    const allocationPct = getAllocationPercentage();
    const totalPct = getTotalPercentage();

    assert(totalPct == 100, "Total allocation must equal 100%");
    assert(allocationPct > 0, "Allocation percentage must be positive");

    distributionStatus.insert(disclose(projectId), 1);
}

// 5. Verify a contributor's private allocation matches the rules
export circuit verifyAllocation(projectId: Bytes<32>): [] {
    const contributorKey = callerKey();
    const regKey = persistentHash<[Bytes<32>, Bytes<32>]>([projectId, contributorKey]);

    assert(contributorRegistry.member(disclose(regKey)), "Contributor not registered");
    assert(contributorRegistry.lookup(disclose(regKey)) == true, "Contributor not registered");

    const myAllocation = getAllocationAmount();
    const poolAmount = getPoolAmount();
    const myPercentage = getAllocationPercentage();

    assert(myAllocation * 100 == poolAmount * myPercentage, "Allocation does not match agreed percentage");

    allocationVerified.insert(disclose(regKey), disclose(true));
    totalAllocationsVerified.increment(1);
}

// 6. Finalize distribution
export circuit finalizeDistribution(projectId: Bytes<32>): [] {
    const caller = callerKey();
    assert(projectOwners.member(disclose(projectId)), "Project not found");
    assert(projectOwners.lookup(disclose(projectId)) == caller, "Only owner can finalize");

    distributionStatus.insert(disclose(projectId), 2);
}

// 7. Claim payment (contributor proves their allocation)
export circuit claimPayment(projectId: Bytes<32>): [] {
    const contributorKey = callerKey();
    const regKey = persistentHash<[Bytes<32>, Bytes<32>]>([projectId, contributorKey]);

    assert(allocationVerified.member(disclose(regKey)), "Allocation not yet verified");
    assert(allocationVerified.lookup(disclose(regKey)) == true, "Allocation not yet verified");

    assert(distributionStatus.member(disclose(projectId)), "Distribution not yet finalized");
    assert(distributionStatus.lookup(disclose(projectId)) == 2, "Distribution not yet finalized");
}

// 8. Query project verification status
export circuit getProjectStatus(projectId: Bytes<32>): Uint<64> {
    assert(distributionStatus.member(disclose(projectId)), "Project not found");
    return distributionStatus.lookup(disclose(projectId));
}
